<form
  class="formAdvertisement"
  action="#"
  method="post"
  enctype="multipart/form-data"
>
  <div class="form-group">
    <label for="advertisementPhotos">Fotky</label>

    <div class="formAdvertisement-upload">
      <div class="formAdvertisement-upload__grid js-advertisement-photos">
        <label class="formAdvertisement-upload__add">
          <span class="formAdvertisement-upload__plus">+</span>
          <span class="formAdvertisement-upload__addText"> Přidat fotky </span>

          <input
            id="advertisementPhotos"
            class="formAdvertisement-upload__input"
            type="file"
            name="photos[]"
            accept="image/jpeg,image/png,image/webp"
            multiple
            required
          />
        </label>
      </div>

      <div class="formAdvertisement-upload__bottom">
        <span class="formAdvertisement-upload__count">
          Nahráno 0 fotografií
        </span>
        <span class="formAdvertisement-upload__hint">
          Podporované formáty: JPG, PNG, WebP
        </span>
      </div>
    </div>
  </div>

  <div class="form-group">
    <label for="advertisementTitle">Název</label>
    <input id="advertisementTitle" type="text" name="title" required />
  </div>

  <div class="form-group">
    <label for="advertisementPrice">Cena</label>
    <input
      id="advertisementPrice"
      type="number"
      name="price"
      min="0"
      step="1"
      placeholder="Cena v Kč"
      required
    />
  </div>

  <div class="form-group">
    <label for="advertisementDescription">Popis</label>
    <textarea
      id="advertisementDescription"
      name="description"
      rows="6"
      required
    ></textarea>
  </div>

  <div class="form-group">
    <label for="advertisementName">Jméno inzerenta</label>
    <input
      id="advertisementName"
      type="text"
      name="advertiser_name"
      autocomplete="name"
      required
    />
  </div>

  <div class="form-group">
    <label for="advertisementEmail">E-mail inzerenta</label>
    <input
      id="advertisementEmail"
      type="email"
      name="advertiser_email"
      autocomplete="email"
      required
    />
  </div>

  <div class="form-group">
    <label for="advertisementPhone"> Telefon inzerenta </label>

    <input
      id="advertisementPhone"
      type="tel"
      name="advertiser_phone"
      autocomplete="tel"
    />
  </div>

  <button class="formAdvertisement__submit" type="submit">
    Vložit inzerát
  </button>
</form>
